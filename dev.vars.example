# Copy this file to .dev.vars for local development.
# Never commit the populated .dev.vars file.

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_SIGN_IN_URL=/sign-in
CLERK_SIGN_UP_URL=/sign-up
CLERK_AFTER_SIGN_IN_URL=/
CLERK_AFTER_SIGN_UP_URL=/
# Comma-separated authorized parties for server-side Clerk token validation.
# Keep the two production origins in deployed configuration. Add
# http://127.0.0.1:4174 only in ignored local `.dev.vars` when using the local
# AskAI function harness; Clerk itself must also permit that development origin.
CLERK_AUTHORIZED_PARTIES=https://www.level-grind.com,https://level-grind.com

LEVEL_GRIND_OWNER_EMAIL=you@example.com
LEVEL_GRIND_MEMBER_MANAGER_EMAILS=co-manager@example.com
LEVEL_GRIND_INVITED_EMAILS=you@example.com

AI_PROVIDER=deepseek
# Preferred key name. DEEPSEEK_API_KEY and DEEPSEEK_MODEL remain accepted as
# a compatibility fallback for the already-configured EdgeOne deployment.
AI_API_KEY=replace_me
AI_MODEL=deepseek-v4-flash
AI_BASE_URL=https://api.deepseek.com
AI_MAX_OUTPUT_TOKENS=1800
AI_INPUT_USD_PER_MTOK=0.14
AI_CACHED_INPUT_USD_PER_MTOK=0.0028
AI_OUTPUT_USD_PER_MTOK=0.28

WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=replace_me

# Optional OpenRouter pilot. Keep this server-side and leave it disabled for
# internal Notes/Ideas unless the deployment owner explicitly approves it.
OPENROUTER_API_KEY=replace_me
OPENROUTER_DEFAULT_MODEL=
OPENROUTER_ALLOWED_MODELS=
# Only models listed here may receive an OpenRouter `reasoning` parameter.
OPENROUTER_THINKING_MODELS=
# Optional JSON price map used only for an auditable per-request estimate, e.g.
# {"provider/model":{"input":0.5,"output":2.0}}. Values are USD / 1M tokens.
OPENROUTER_MODEL_PRICES_USD_PER_MTOK={}
OPENROUTER_ALLOW_INTERNAL_DATA=false
OPENROUTER_HTTP_REFERER=https://www.level-grind.com
OPENROUTER_APP_TITLE=Level Grind

# WeChat Bot / Codex claim ingestion. Generate a long random value and send it
# only as the X-Claim-Ingest-Secret header from the local bridge.
CLAIM_INGEST_SECRET=replace_with_a_long_random_secret

# TencentDB/COS Notes service. EdgeOne forwards the signed-in Clerk token to
# this private service; it must validate the token and enforce team membership.
# Leave empty until the Tencent backend is provisioned: Notes then shows an
# honest unavailable state instead of falling back to browser or Supabase data.
NOTES_SERVICE_BASE_URL=
