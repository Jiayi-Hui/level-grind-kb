{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "npm run claims:sync && npm run events:sync-research && npm run aidc:sync && cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "notes-api:start": "node services/tencent-notes-api/server.mjs",
    "notes:attachment:preflight": "node scripts/verify-notes-attachment-deployment.mjs --strict",
    "price-refresh:preflight": "node scripts/verify-price-refresh-deployment.mjs --strict",
    "askai:sse:smoke": "node scripts/smoke-askai-sse.mjs",
    "askai:route:diagnose": "node scripts/diagnose-askai-route.mjs",
    "askai:local:function": "node scripts/local-agent-chat-server.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern deploy/edgeone-demo/dist",
    "db:generate": "drizzle-kit generate",
    "events:sql": "node scripts/events-to-sql.mjs",
    "events:knowledge": "node scripts/build-event-knowledge-seed.mjs",
    "events:sync-research": "node scripts/sync-event-research.mjs",
    "claims:sync": "node scripts/sync-claim-ledger.mjs",
    "claims:publish": "node scripts/publish-claim-ledger.mjs",
    "aidc:sync": "node scripts/sync-aidc-capex.mjs",
    "aidc:refresh": "node scripts/refresh-epoch-ai-data.mjs && AIDC_RESEARCH_ROOT=. node scripts/sync-aidc-capex.mjs && AIDC_RESEARCH_ROOT=. node scripts/geocode-aidc-capex.mjs",
    "aidc:publish": "node scripts/publish-aidc-capex.mjs",
    "idea-graph:sync": "node scripts/sync-investment-graph.mjs",
    "edgeone-demo:build": "npm run claims:publish && npm run aidc:publish && vite build --config deploy/edgeone-demo/vite.config.ts",
    "edgeone-demo:dev": "vite --config deploy/edgeone-demo/vite.config.ts",
    "edgeone-demo:build:research": "npm run claims:sync && npm run aidc:sync && node scripts/geocode-aidc-capex.mjs && npm run aidc:publish && vite build --config deploy/edgeone-demo/vite.config.ts",
    "claim:inbox": "node scripts/publish-claim-inbox.mjs",
    "cninfo:fetch": "node scripts/cninfo-fetch.mjs",
    "backup:export": "node scripts/export-production-backup.mjs",
    "backup:materialize-reports": "node scripts/materialize-backup-reports.mjs",
    "backup:verify": "node scripts/verify-production-backup.mjs",
    "backup:restore": "node scripts/restore-production-backup.mjs"
  },
  "dependencies": {
    "@clerk/backend": "^3.13.0",
    "@clerk/react": "^6.12.7",
    "@edgeone/pages-blob": "^0.0.15",
    "@huggingface/transformers": "^3.8.1",
    "@jiayi-hui/investment-graph": "file:vendor/investment-graph",
    "cos-nodejs-sdk-v5": "^2.15.4",
    "cross-env": "^10.1.0",
    "cytoscape": "^3.34.0",
    "d3-geo": "^3.1.1",
    "drizzle-orm": "0.45.2",
    "fflate": "^0.8.2",
    "next": "16.2.6",
    "pg": "^8.22.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "^3.9.2",
    "topojson-client": "^3.1.0",
    "unpdf": "^1.8.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
